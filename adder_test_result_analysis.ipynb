    "a_list, b_list = [], []\n",
    "expected_list, actual_list, result_list = [], [], []\n",
    "\n",
    "for a, b in test_inputs:\n",
    "    expected = a + b                 # correct answer\n",
    "    actual = faulty_adder(a, b)      # answer given by the adder\n",
    "    result = check_result(expected, actual)\n",
    "\n",
    "    a_list.append(a)\n",
    "    b_list.append(b)\n",
    "    expected_list.append(expected)\n",
    "    actual_list.append(actual)\n",
    "    result_list.append(result)\n",
    "\n",
    "# Print the result table\n",
    "print(f\"{'Test':<5}{'A':>4}{'B':>4}{'Expected':>10}{'Actual':>8}{'Result':>8}\")\n",
    "print(\"-\" * 39)\n",
    "for i in range(len(test_inputs)):\n",
    "    print(f\"{i+1:<5}{a_list[i]:>4}{b_list[i]:>4}{expected_list[i]:>10}{actual_list[i]:>8}{result_list[i]:>8}\")"
   ]
