   "source": [
    "### 5.2 User-defined functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "40e3876d",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-29T17:52:33.959869Z",
     "iopub.status.busy": "2026-10-29T17:52:33.959045Z",
     "iopub.status.idle": "2026-10-29T17:52:33.967140Z",
     "shell.execute_reply": "2026-10-29T17:52:33.965958Z"
    }
   },
   "outputs": [],
   "source": [
    "def faulty_adder(a, b):\n",
    "    \"\"\"Simulates the faulty 4-bit adder .\n",
    "    The carry is lost, so only the lower 4 bits of the sum are kept.\"\"\"\n",
    "    return (a + b) & 0b1111      # same as (a + b) % 16\n",
    "\n",
    "\n",
    "def check_result(expected, actual):\n",
    "    \"\"\"Returns 'PASS' if expected and actual are equal, else 'FAIL'.\"\"\"\n",
    "    if expected == actual:\n",
    "        return \"PASS\"\n",
    "    else:\n",
    "        return \"FAIL\"\n",
    "\n",
    "\n",
    "def count_results(results):\n",
    "    \"\"\"Counts PASS and FAIL in the results list and returns a dictionary.\"\"\"\n",
    "    summary = {\"PASS\": 0, \"FAIL\": 0}\n",
    "    for r in results:\n",
    "        summary[r] += 1\n",
    "    return summary\n",
    "\n",
    "\n",
    "def pass_percentage(passed, total):\n",
    "    \"\"\"Returns the pass percentage.\"\"\"\n",
    "    return passed / total * 100"
   ]
  },
