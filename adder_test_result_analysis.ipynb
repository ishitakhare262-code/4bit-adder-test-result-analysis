    "# Test cases: each pair is (A, B), both are 4-bit values (0 to 15)\n",
    "test_inputs = [\n",
    "    (0, 0), (1, 1), (2, 3), (5, 4), (7, 8),\n",
    "    (9, 6), (15, 0), (0, 15), (8, 7), (10, 5),\n",
    "    (12, 3), (8, 8), (9, 9), (15, 1), (11, 7),\n",
    "    (13, 6), (14, 14), (15, 15), (6, 12), (3, 4),\n",
    "]\n",
    "\n",
    "print(\"Total number of test cases:\", len(test_inputs))"
   ]
  },
